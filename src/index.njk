  <div class="hero-content">
    <div class="hero-left">
      <h1 class="hero-title">Sumora</h1>
    </div>
    <div class="polaroid-stack">
      <figure class="hero-image back" aria-hidden="true"><img alt="" decoding="async" loading="lazy"></figure>
      <figure class="hero-image mid" aria-hidden="true"><img alt="" decoding="async" loading="lazy"></figure>
      <figure class="hero-image front"><img alt="夏日拍立得" decoding="async"></figure>
    </div>
  </div>

  <script>
    // 拍立得堆叠：打开时随机抽照片，点击整叠往前轮换一张；只用项目内照片，不足的层直接不显示
    (function () {
      var photos = {{ polaroid | dump | safe }};
      var srcs = photos.slice();
      var cursor = srcs.length > 0 ? Math.floor(Math.random() * srcs.length) : 0;
      var imgs = document.querySelectorAll(".polaroid-stack img"); // 顺序: back, mid, front
      var stack = document.querySelector(".polaroid-stack");

      function apply() {
        // 本地照片优先给最上层 front；照片不够的层直接隐藏
        [imgs[2], imgs[1], imgs[0]].forEach(function (img, k) {
          var figure = img.parentNode;
          if (k < srcs.length) {
            img.src = srcs[(cursor + k) % srcs.length];
            figure.style.display = "";
          } else {
            img.removeAttribute("src");
            figure.style.display = "none";
          }
        });
      }

      apply();

      if (stack) {
        // 点击整叠：往前轮换一张，并触发一次翻片动画
        stack.addEventListener("click", function () {
          if (!srcs.length) return;
          cursor = (cursor + 1) % srcs.length;
          apply();
          stack.classList.remove("switch-anim");
          void stack.offsetWidth; // 强制回流以重启动画
          stack.classList.add("switch-anim");
        });
      }
    })();
  </script>
