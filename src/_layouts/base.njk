<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "Sumora" }}</title>
  <meta name="description" content="{{ description or "Sumora — 夏天限定，只在夏日发生。" }}">
  <link rel="preconnect" href="https://fonts.bunny.net">
  <link href="https://fonts.bunny.net/css?family=inter:300,400,500|space-grotesk:300,400,500|lobster:400" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css?v=2">
  <script>
    // 主题：优先使用上次手动选择，否则跟随系统，避免闪烁
    (function () {
      const saved = localStorage.getItem("sumora-theme");
      const prefersLight = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
      const theme = saved ? saved : (prefersLight ? "light" : "dark");
      document.documentElement.setAttribute("data-theme", theme);
    })();
  </script>
</head>
<body>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-left">
        <p class="footer-brand">Sumora</p>
        <p class="footer-slogan">对世界，保持夏天的温度</p>
      </div>
      <div class="footer-right">
        <p class="footer-copy">&copy; {{ "now" | year }} · design by sumora</p>
        <a class="footer-beian" href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">粤ICP备2025426509号-5</a>
      </div>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js" integrity="sha384-XmJ9SoHtVOHoQUcKvFAzVXwdkKo1Ie3bhmSoIAkcdsHGaIrVJIkmozyq0FJeb/Ly" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js" integrity="sha384-wl5TeDVvOWt30Pbf8aSo2ZrzsOjddu3avOBvHe+p+OhJt9gP6w9YXmDkN5DK2/dF" crossorigin="anonymous"></script>
  <script src="/assets/js/space.js"></script>
</body>
</html>
